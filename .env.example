# DigitalOcean Container Registry image
ZIEE_IMAGE=registry.digitalocean.com/ziee/ziee:main

# Public URL (used in emails, billing redirects, etc.)
ZIEE_SERVER_URL=http://localhost

# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ziee

# Nginx
NGINX_HTTP_PORT=80

# Optional: AI, mail, billing
# ZIEE_AI_OROUTE_API_KEY=
# ZIEE_RESEND_API_KEY=
# ZIEE_STRIPE_SECRET_KEY=
# ZIEE_STRIPE_WEBHOOK_SECRET=
