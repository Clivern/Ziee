#!/usr/bin/env bash

set -euo pipefail

RELEASE_URL="https://github.com/stripe/stripe-cli/releases/latest"
INSTALL_DIR="${INSTALL_DIR:-/usr/local/bin}"

command_exists() {
  command -v "$1" >/dev/null 2>&1
}

if [[ "$(uname -s)" != "Darwin" ]]; then
  echo "This installer is for macOS only." >&2
  exit 1
fi

if ! command_exists curl; then
  echo "curl is required to download the Stripe CLI." >&2
  exit 1
fi

if ! command_exists tar; then
  echo "tar is required to extract the Stripe CLI archive." >&2
  exit 1
fi

case "$(uname -m)" in
  arm64)
    ARCH="arm64"
    ;;
  x86_64)
    ARCH="x86_64"
    ;;
  *)
    echo "Unsupported macOS architecture: $(uname -m)" >&2
    exit 1
    ;;
esac

LATEST_URL="$(curl -fsSLI -o /dev/null -w '%{url_effective}' "$RELEASE_URL")"
VERSION="${LATEST_URL##*/v}"

if [[ -z "$VERSION" || "$VERSION" == "$LATEST_URL" ]]; then
  echo "Unable to determine latest Stripe CLI version from $RELEASE_URL" >&2
  exit 1
fi

ARCHIVE="stripe_${VERSION}_mac-os_${ARCH}.tar.gz"
DOWNLOAD_URL="https://github.com/stripe/stripe-cli/releases/download/v${VERSION}/${ARCHIVE}"
TMP_DIR="$(mktemp -d)"

cleanup() {
  rm -rf "$TMP_DIR"
}
trap cleanup EXIT

echo "Downloading Stripe CLI v${VERSION} for macOS ${ARCH}..."
curl -fL "$DOWNLOAD_URL" -o "$TMP_DIR/$ARCHIVE"

echo "Extracting $ARCHIVE..."
tar -xzf "$TMP_DIR/$ARCHIVE" -C "$TMP_DIR"

if [[ ! -x "$TMP_DIR/stripe" ]]; then
  echo "The Stripe CLI binary was not found in the archive." >&2
  exit 1
fi

if [[ ! -d "$INSTALL_DIR" ]]; then
  echo "Install directory does not exist: $INSTALL_DIR" >&2
  exit 1
fi

echo "Installing stripe to $INSTALL_DIR/stripe..."
if [[ -w "$INSTALL_DIR" ]]; then
  install "$TMP_DIR/stripe" "$INSTALL_DIR/stripe"
else
  sudo install "$TMP_DIR/stripe" "$INSTALL_DIR/stripe"
fi

echo "Stripe CLI installed successfully:"
"$INSTALL_DIR/stripe" version
