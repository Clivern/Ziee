#!/usr/bin/env python3
"""Run a local Qdrant vector database with Apple Container.

Basic usage:
  ./bin/qdrant start
  ./bin/qdrant credentials
  ./bin/qdrant status
  ./bin/qdrant logs
  ./bin/qdrant stop
  ./bin/qdrant restart
  ./bin/qdrant health
  ./bin/qdrant remove
  ./bin/qdrant remove --with-volume
"""

from __future__ import annotations

import argparse
import json
import shutil
import subprocess
import sys
from dataclasses import dataclass
from pathlib import Path


DEFAULT_IMAGE = "docker.io/qdrant/qdrant:latest"
DEFAULT_CONTAINER = "actx0-qdrant"
DEFAULT_VOLUME = "actx0-qdrant-data"
DEFAULT_HOST = "127.0.0.1"
DEFAULT_HTTP_PORT = 6333
DEFAULT_GRPC_PORT = 6334
DEFAULT_VECTOR_SIZE = 1024
DEFAULT_POOL_SIZE = 3
DEFAULT_DATA_MOUNT = "/qdrant/volume"
DEFAULT_STORAGE_PATH = f"{DEFAULT_DATA_MOUNT}/data"

HELP_TEXT = f"""examples:
  ./bin/qdrant start
  ./bin/qdrant credentials
  ./bin/qdrant status
  ./bin/qdrant logs
  ./bin/qdrant stop
  ./bin/qdrant restart
  ./bin/qdrant health
  ./bin/qdrant remove
  ./bin/qdrant remove --with-volume

default app environment:
  export ACTX0_AI_QDRANT_HOST={DEFAULT_HOST}
  export ACTX0_AI_QDRANT_PORT={DEFAULT_GRPC_PORT}
  export ACTX0_AI_QDRANT_API_KEY=
  export ACTX0_AI_QDRANT_USE_TLS=false
  export ACTX0_AI_QDRANT_VECTOR_SIZE={DEFAULT_VECTOR_SIZE}
  export ACTX0_AI_QDRANT_POOL_SIZE={DEFAULT_POOL_SIZE}
"""


@dataclass(frozen=True)
class QdrantConfig:
    image: str
    container: str
    volume: str
    host: str
    http_port: int
    grpc_port: int
    api_key: str
    vector_size: int
    pool_size: int


def run_container(
    *args: str, check: bool = True, capture: bool = False
) -> subprocess.CompletedProcess[str]:
    if shutil.which("container") is None:
        print("container CLI is required but was not found in PATH", file=sys.stderr)
        raise SystemExit(1)

    try:
        return subprocess.run(
            ["container", *args],
            check=check,
            capture_output=capture,
            text=True,
        )
    except subprocess.CalledProcessError as exc:
        if exc.stderr:
            print(exc.stderr.strip(), file=sys.stderr)
        raise SystemExit(exc.returncode)


def ensure_ready() -> None:
    result = subprocess.run(
        ["container", "system", "status", "--format", "json"],
        capture_output=True,
        text=True,
    )
    if result.returncode != 0:
        print("container system is not running; run: container system start", file=sys.stderr)
        raise SystemExit(1)

    try:
        status = json.loads(result.stdout)
    except json.JSONDecodeError:
        print("container system is not running; run: container system start", file=sys.stderr)
        raise SystemExit(1)

    if status.get("status") != "running":
        print("container system is not running; run: container system start", file=sys.stderr)
        raise SystemExit(1)

    app_root = status.get("appRoot", "")
    kernels_dir = Path(app_root) / "kernels"
    if app_root and kernels_dir.is_dir() and not any(kernels_dir.iterdir()):
        print("Installing recommended container kernel...", file=sys.stderr)
        kernel = subprocess.run(
            ["container", "system", "kernel", "set", "--recommended"],
            text=True,
        )
        if kernel.returncode != 0:
            print("Run: container system kernel set --recommended", file=sys.stderr)
            raise SystemExit(kernel.returncode)


def inspect_container(name: str) -> dict | None:
    result = run_container("inspect", name, check=False, capture=True)
    if result.returncode != 0:
        return None
    try:
        data = json.loads(result.stdout)
    except json.JSONDecodeError:
        return None
    if isinstance(data, list):
        return data[0] if data else None
    return data


def container_state(info: dict) -> str:
    status = info.get("status", "?")
    if isinstance(status, dict):
        return str(status.get("state", "?"))
    return str(status)


def container_exists(name: str) -> bool:
    return inspect_container(name) is not None


def container_is_running(name: str) -> bool:
    info = inspect_container(name)
    return info is not None and container_state(info) == "running"


def credentials(cfg: QdrantConfig) -> str:
    return f"""Qdrant credentials
Container:   {cfg.container}
Image:       {cfg.image}
REST API:    http://{cfg.host}:{cfg.http_port}
gRPC API:    {cfg.host}:{cfg.grpc_port}
Dashboard:   http://{cfg.host}:{cfg.http_port}/dashboard
Collections: run `actx0 migrate up -c <config>`

App environment:
export ACTX0_AI_QDRANT_HOST={cfg.host}
export ACTX0_AI_QDRANT_PORT={cfg.grpc_port}
export ACTX0_AI_QDRANT_API_KEY={cfg.api_key}
export ACTX0_AI_QDRANT_USE_TLS=false
export ACTX0_AI_QDRANT_VECTOR_SIZE={cfg.vector_size}
export ACTX0_AI_QDRANT_POOL_SIZE={cfg.pool_size}
"""


def start(cfg: QdrantConfig, pull: bool) -> None:
    ensure_ready()
    if pull:
        run_container("image", "pull", cfg.image)

    if container_exists(cfg.container):
        if container_is_running(cfg.container):
            print(f"{cfg.container} is already running")
        else:
            run_container("start", cfg.container)
            print(f"started existing container {cfg.container}")
        print()
        print(credentials(cfg))
        return

    run_args = [
        "run",
        "-d",
        "--name",
        cfg.container,
        "-e",
        f"QDRANT__STORAGE__STORAGE_PATH={DEFAULT_STORAGE_PATH}",
        "-p",
        f"{cfg.http_port}:6333",
        "-p",
        f"{cfg.grpc_port}:6334",
        "-v",
        f"{cfg.volume}:{DEFAULT_DATA_MOUNT}",
    ]
    if cfg.api_key:
        run_args.extend(["-e", f"QDRANT__SERVICE__API_KEY={cfg.api_key}"])

    run_args.append(cfg.image)
    run_container(*run_args)
    print(f"created and started container {cfg.container}")
    print()
    print(credentials(cfg))


def stop(cfg: QdrantConfig) -> None:
    ensure_ready()
    if not container_exists(cfg.container):
        print(f"{cfg.container} does not exist")
        return
    if not container_is_running(cfg.container):
        print(f"{cfg.container} is already stopped")
        return
    run_container("stop", cfg.container)
    print(f"stopped {cfg.container}")


def restart(cfg: QdrantConfig) -> None:
    ensure_ready()
    if not container_exists(cfg.container):
        start(cfg, pull=False)
        return
    if container_is_running(cfg.container):
        run_container("stop", cfg.container)
    run_container("start", cfg.container)
    print(f"restarted {cfg.container}")
    print()
    print(credentials(cfg))


def remove(cfg: QdrantConfig, volume: bool) -> None:
    ensure_ready()
    if container_exists(cfg.container):
        run_container("delete", "--force", cfg.container)
        print(f"removed container {cfg.container}")
    else:
        print(f"{cfg.container} does not exist")

    if volume:
        result = run_container(
            "volume", "delete", cfg.volume, check=False, capture=True
        )
        if result.returncode == 0:
            print(f"removed volume {cfg.volume}")
        else:
            print(f"volume {cfg.volume} does not exist or could not be removed")


def status(cfg: QdrantConfig) -> None:
    ensure_ready()
    info = inspect_container(cfg.container)
    if info is None:
        print(f"{cfg.container} does not exist")
        return
    print(f"{cfg.container}: {container_state(info)}")


def logs(cfg: QdrantConfig, follow: bool) -> None:
    ensure_ready()
    if not container_exists(cfg.container):
        print(f"{cfg.container} does not exist")
        return

    args = ["logs"]
    if follow:
        args.append("--follow")
    args.append(cfg.container)
    run_container(*args)


def health(cfg: QdrantConfig) -> None:
    ensure_ready()
    if not container_exists(cfg.container):
        print(f"{cfg.container} does not exist")
        return
    if not container_is_running(cfg.container):
        print(f"{cfg.container} is not running")
        return

    if shutil.which("curl") is None:
        print("curl is required but was not found in PATH", file=sys.stderr)
        raise SystemExit(1)

    for path in ("/healthz", "/readyz"):
        url = f"http://{cfg.host}:{cfg.http_port}{path}"
        result = subprocess.run(
            ["curl", "--fail", "--silent", "--show-error", url],
            check=False,
            capture_output=True,
            text=True,
        )
        if result.returncode != 0:
            print(f"{path}: unavailable")
            if result.stderr:
                print(result.stderr.strip(), file=sys.stderr)
            raise SystemExit(1)
        print(f"{path}: {result.stdout.strip() or 'ok'}")


def add_common_options(parser: argparse.ArgumentParser) -> None:
    parser.add_argument(
        "--image",
        default=DEFAULT_IMAGE,
        help=f"Qdrant image (default: {DEFAULT_IMAGE})",
    )
    parser.add_argument(
        "--container",
        default=DEFAULT_CONTAINER,
        help=f"Container name (default: {DEFAULT_CONTAINER})",
    )
    parser.add_argument(
        "--volume",
        default=DEFAULT_VOLUME,
        help=f"Container volume name (default: {DEFAULT_VOLUME})",
    )
    parser.add_argument(
        "--host",
        default=DEFAULT_HOST,
        help=f"Host shown in app credentials (default: {DEFAULT_HOST})",
    )
    parser.add_argument(
        "--http-port",
        type=int,
        default=DEFAULT_HTTP_PORT,
        help=f"REST API host port (default: {DEFAULT_HTTP_PORT})",
    )
    parser.add_argument(
        "--grpc-port",
        type=int,
        default=DEFAULT_GRPC_PORT,
        help=f"gRPC API host port (default: {DEFAULT_GRPC_PORT})",
    )
    parser.add_argument(
        "--api-key",
        default="",
        help="Qdrant API key for local auth (default: disabled)",
    )
    parser.add_argument(
        "--vector-size",
        type=int,
        default=DEFAULT_VECTOR_SIZE,
        help=f"Embedding vector size for app config (default: {DEFAULT_VECTOR_SIZE})",
    )
    parser.add_argument(
        "--pool-size",
        type=int,
        default=DEFAULT_POOL_SIZE,
        help=f"Qdrant client pool size for app config (default: {DEFAULT_POOL_SIZE})",
    )


def build_parser() -> argparse.ArgumentParser:
    common_parser = argparse.ArgumentParser(add_help=False)
    add_common_options(common_parser)

    parser = argparse.ArgumentParser(
        description="Run a local Qdrant vector database for actx0 with Apple Container.",
        epilog=HELP_TEXT,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    add_common_options(parser)

    subparsers = parser.add_subparsers(dest="command")

    start_parser = subparsers.add_parser(
        "start",
        parents=[common_parser],
        help="Create or start the Qdrant container",
    )
    start_parser.add_argument(
        "--pull", action="store_true", help="Pull the image before starting"
    )

    subparsers.add_parser(
        "stop", parents=[common_parser], help="Stop the Qdrant container"
    )
    subparsers.add_parser(
        "restart", parents=[common_parser], help="Restart the Qdrant container"
    )
    subparsers.add_parser(
        "status", parents=[common_parser], help="Show container status"
    )
    subparsers.add_parser(
        "credentials", parents=[common_parser], help="Print app Qdrant credentials"
    )
    subparsers.add_parser(
        "health", parents=[common_parser], help="Check Qdrant health endpoints"
    )

    logs_parser = subparsers.add_parser(
        "logs", parents=[common_parser], help="Show Qdrant container logs"
    )
    logs_parser.add_argument("-f", "--follow", action="store_true", help="Follow logs")

    remove_parser = subparsers.add_parser(
        "remove", parents=[common_parser], help="Remove the Qdrant container"
    )
    remove_parser.add_argument(
        "--with-volume", action="store_true", help="Also remove the container volume"
    )

    return parser


def main() -> int:
    parser = build_parser()
    args = parser.parse_args()

    cfg = QdrantConfig(
        image=args.image,
        container=args.container,
        volume=args.volume if isinstance(args.volume, str) else DEFAULT_VOLUME,
        host=args.host,
        http_port=args.http_port,
        grpc_port=args.grpc_port,
        api_key=args.api_key,
        vector_size=args.vector_size,
        pool_size=args.pool_size,
    )

    command = args.command or "start"

    if command == "start":
        start(cfg, pull=getattr(args, "pull", False))
    elif command == "stop":
        stop(cfg)
    elif command == "restart":
        restart(cfg)
    elif command == "status":
        status(cfg)
    elif command == "credentials":
        print(credentials(cfg))
    elif command == "logs":
        logs(cfg, follow=getattr(args, "follow", False))
    elif command == "remove":
        remove(cfg, volume=getattr(args, "with_volume", False))
    elif command == "health":
        health(cfg)
    else:
        parser.error(f"unknown command: {command}")

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
