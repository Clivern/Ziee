# DigitalOcean Container Registry image
ZIEE_IMAGE=registry.digitalocean.com/ziee/ziee:main

# oss disables Stripe; the published registry image is built as saas
ZIEE_EDITION=oss

# Public URL (used in emails and OAuth redirects)
ZIEE_SERVER_URL=http://localhost

# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ziee

# Nginx
NGINX_HTTP_PORT=80

# GitHub App
ZIEE_GITHUB_OAUTH_CLIENT_ID=
ZIEE_GITHUB_OAUTH_CLIENT_SECRET=
ZIEE_GITHUB_OAUTH_REDIRECT_URL=
ZIEE_GITHUB_WEBHOOK_SECRET=
ZIEE_GITHUB_ENCRYPTION_KEY=
ZIEE_GITHUB_APP_PRIVATE_KEY_FILE=./priv_key.pem

# AI
ZIEE_AI_OROUTE_API_KEY=

# Mail
ZIEE_RESEND_API_KEY=
ZIEE_MAILER_FROM=
